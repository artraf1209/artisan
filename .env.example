# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Alpaca broker ─────────────────────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
PAPER_TRADING=true

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI / ML ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
OPENAI_API_KEY=
# Requests/sec pacing to stay under each API's rate limit during nightly
# ingest's per-symbol fetch loops -- not derived from any documented plan
# limit, tune to match yours. 0 disables pacing. Defaults: 5.0, 2.0.
FMP_REQUESTS_PER_SECOND=
FINNHUB_REQUESTS_PER_SECOND=

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_SECRET=
AUTH_PASSWORD=
# Full production URL (scheme + host, no trailing slash) -- required for
# Face ID/Touch ID login (WebAuthn's relying-party ID and origin checks).
NEXT_PUBLIC_APP_URL=

# ── Hybrid engine defaults ────────────────────────────────────────────────────
STRATEGY_ID=00000000-0000-0000-0000-000000000010
ACCOUNT_ID=00000000-0000-0000-0000-000000000002
ADMIN_USER_ID=00000000-0000-0000-0000-000000000001
LOG_LEVEL=INFO
